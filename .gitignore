# data never goes to git (Binance terms: only derived statistics are published)
data/*
!data/.gitkeep
# results snapshot: published as a release file (`ofs snapshot export`), unpacked locally
/snapshot/
results-snapshot.zip
results-snapshot.zip.part

# generated report artefacts (rebuilt by `make report`)
paper/figures/*.pdf
paper/figures/*.png
paper/tables/*.tex
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
site/

