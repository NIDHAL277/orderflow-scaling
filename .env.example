# Copy to .env (never committed). The pipeline itself needs no secret: these are
# optional operational settings for monitoring, backups and the public hostnames.

# Healthchecks.io ping URL (alert when the daily ping is missing)
OFS_HEALTHCHECKS_URL=

# Public hostnames served by Caddy (automatic HTTPS)
OFS_API_HOST=api.localhost
OFS_DASHBOARD_HOST=dashboard.localhost
OFS_API_RATE_PER_MINUTE=120

# Image to run (published on GHCR by the release workflow)
GITHUB_OWNER=nidhal277
OFS_IMAGE_TAG=latest

# Weekly backup to Cloudflare R2 (rclone remote "r2", S3-compatible)
RCLONE_REMOTE=r2:orderflow-scaling
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
